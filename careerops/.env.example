# Environment Variables for CareerOps
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database
DB_URL=jdbc:mysql://localhost:3306/careerops?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Server
SERVER_PORT=8080

# JWT
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=120

# File Upload
MAX_FILE_SIZE=10MB

# Fit Algorithm Weights (must sum to 100)
FIT_SKILL_WEIGHT=40
FIT_RESPONSIBILITY_WEIGHT=25
FIT_EXPERIENCE_WEIGHT=20
FIT_RESUME_WEIGHT=15

# AI Integration (optional)
AI_ENABLED=false
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2
