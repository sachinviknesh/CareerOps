# ============================================================
# CAREEROPS BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development (do not commit .env)
# ============================================================

# Database Configuration (MySQL required for college submission)
DB_URL=jdbc:mysql://localhost:3306/careerops?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# Server Configuration
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# Security & JWT Authentication
JWT_SECRET=supersecretjwtkeywithsufficientlengthforproductiongrade32bytes
JWT_EXPIRATION_MINUTES=120

# Optional AI Configuration (Gemini API - works even if disabled)
AI_ENABLED=true
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.8-flash

# Optional Remote Job API Configuration
JOBS_MOCK_ENABLED=true
JOBS_REMOTE_ENABLED=false
JOB_API_KEY=
JOBS_REMOTE_BASE_URL=
